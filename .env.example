# Description: Example of .env file
# Usage: Copy this file to .env and change the values
#        according to your needs
#        Do not commit .env file to git
#        Do not change .env.example file

# Config directory
# Directory where files, logs and database will be stored
# Example: PRIMEAGENT_CONFIG_DIR=~/.primeagent
PRIMEAGENT_CONFIG_DIR=

# Save database in the config directory
# Values: true, false
# If false, the database will be saved in Primeagent's root directory
# This means that the database will be deleted when Primeagent is uninstalled
# and that the database will not be shared between different virtual environments
# Example: PRIMEAGENT_SAVE_DB_IN_CONFIG_DIR=true
PRIMEAGENT_SAVE_DB_IN_CONFIG_DIR=

# Database URL
# Postgres example: PRIMEAGENT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/primeagent  # pragma: allowlist secret
# SQLite example:
PRIMEAGENT_DATABASE_URL=sqlite:///./primeagent.db

# Alembic logs path flag. If set to true, Alembic will log to stdout.
PRIMEAGENT_ALEMBIC_LOG_TO_STDOUT=False

# mem0 creates a directory
# for chat history, vector stores, and other artifacts
# its default path is ~/.mem0.
# we can change this path with
# environment variable "MEM0_DIR"
# Example: MEM0_DIR=/tmp/.mem0

# composio creates a cache directory
# for file uploads/downloads.
# its default path is ~/.composio
# we can change this path with
# environment variable "COMPOSIO_CACHE_DIR"
# Example: COMPOSIO_CACHE_DIR=/tmp/.composio


# Database connection retry
# Values: true, false
# If true, the database will retry to connect to the database if it fails
# Example: PRIMEAGENT_DATABASE_CONNECTION_RETRY=true
PRIMEAGENT_DATABASE_CONNECTION_RETRY=false

# Cache type
PRIMEAGENT_LANGCHAIN_CACHE=SQLiteCache

# Server host
# Example: PRIMEAGENT_HOST=localhost
PRIMEAGENT_HOST=

# Worker processes
# Example: PRIMEAGENT_WORKERS=1
PRIMEAGENT_WORKERS=

# Server port
# Example: PRIMEAGENT_PORT=7860
PRIMEAGENT_PORT=

# Logging level
# Example: PRIMEAGENT_LOG_LEVEL=critical
PRIMEAGENT_LOG_LEVEL=

# Path to the log file
# Example: PRIMEAGENT_LOG_FILE=logs/primeagent.log
PRIMEAGENT_LOG_FILE=

# Time/Size for log to rotate
# Example: PRIMEAGENT_LOG_ROTATION=‘10 MB’/‘1 day’
PRIMEAGENT_LOG_ROTATION=

# Path to the frontend directory containing build files
# Example: PRIMEAGENT_FRONTEND_PATH=/path/to/frontend/build/files
PRIMEAGENT_FRONTEND_PATH=

# Whether to open the browser after starting the server
# Values: true, false
# Example: PRIMEAGENT_OPEN_BROWSER=true
PRIMEAGENT_OPEN_BROWSER=

# Whether to remove API keys from the projects saved in the database
# Values: true, false
# Example: PRIMEAGENT_REMOVE_API_KEYS=false
PRIMEAGENT_REMOVE_API_KEYS=

# Whether to use RedisCache or ThreadingInMemoryCache or AsyncInMemoryCache
# Values: async, memory, redis
# Example: PRIMEAGENT_CACHE_TYPE=memory
# If you want to use redis then the following environment variables must be set:
# PRIMEAGENT_REDIS_HOST (default: localhost)
# PRIMEAGENT_REDIS_PORT (default: 6379)
# PRIMEAGENT_REDIS_DB (default: 0)
# PRIMEAGENT_REDIS_CACHE_EXPIRE (default: 3600)
PRIMEAGENT_CACHE_TYPE=

# Development branches default to true; official release packages, tags, and Docker images default to false.
# Uncomment to override the installation default. Use true only for trusted local development.
# PRIMEAGENT_SUPERUSER_PASSWORD must be set when AUTO_LOGIN is false.
# PRIMEAGENT_SUPERUSER is optional.
# Values: true, false
# PRIMEAGENT_AUTO_LOGIN=false

# SET PRIMEAGENT_ENABLE_SUPERUSER_CLI to false to disable
# superuser creation via the CLI
PRIMEAGENT_ENABLE_SUPERUSER_CLI=

# Superuser username
# Example: PRIMEAGENT_SUPERUSER=admin
PRIMEAGENT_SUPERUSER=

# Superuser password
# Example: PRIMEAGENT_SUPERUSER_PASSWORD=123456
PRIMEAGENT_SUPERUSER_PASSWORD=

# API Key Source
# Controls how API keys are validated for the x-api-key header
# Values: db, env
# - db (default): Validates against API keys stored in the database
# - env: Validates against the PRIMEAGENT_API_KEY environment variable
# Example: PRIMEAGENT_API_KEY_SOURCE=db
PRIMEAGENT_API_KEY_SOURCE=

# API Key (only used when PRIMEAGENT_API_KEY_SOURCE=env)
# The API key to use for authentication when API_KEY_SOURCE is set to 'env'
# This allows injecting a pre-defined API key via environment variables
# (useful for Kubernetes Secrets, CI/CD pipelines, etc.)
# Example: PRIMEAGENT_API_KEY=your-secure-api-key
PRIMEAGENT_API_KEY=

# Rate Limiting Configuration
# Controls rate limiting for login and public-flow endpoints
# PRIMEAGENT_RATE_LIMIT_PER_MINUTE: Number of login attempts allowed per minute per IP
# Values: positive integer (default: 5)
# Example: PRIMEAGENT_RATE_LIMIT_PER_MINUTE=10
PRIMEAGENT_RATE_LIMIT_PER_MINUTE=

# PRIMEAGENT_PUBLIC_FLOW_RATE_LIMIT_PER_MINUTE: Number of anonymous public-flow runs
# allowed per minute per IP (per flow on v1; under the public-workflow bucket on v2)
# Values: positive integer (default: 20)
# Example: PRIMEAGENT_PUBLIC_FLOW_RATE_LIMIT_PER_MINUTE=30
PRIMEAGENT_PUBLIC_FLOW_RATE_LIMIT_PER_MINUTE=

# PRIMEAGENT_RATE_LIMIT_STORAGE_URI: Storage backend for rate limit counters
# Values: memory:// (default, single server) or redis://host:port (production, multiple servers)
# - memory://: Fast, in-memory storage (not shared between server instances, lost on restart)
# - redis://localhost:6379: Persistent, shared storage (required for load-balanced deployments)
# Example: PRIMEAGENT_RATE_LIMIT_STORAGE_URI=redis://localhost:6379
PRIMEAGENT_RATE_LIMIT_STORAGE_URI=

# PRIMEAGENT_RATE_LIMIT_TRUST_PROXY: Trust X-Forwarded-For header for client IP
# Values: true, false (default: false)
# When true, uses rightmost X-Forwarded-For IP (the trusted proxy before us)
# When false, uses direct connection IP (prevents header spoofing in non-proxy deployments)
#
# SECURITY WARNING: Only enable if behind a trusted proxy (nginx, load balancer, etc.)
# This setting controls BOTH the application rate limiter AND uvicorn's proxy header processing.
# When false (default), uvicorn will NOT trust X-Forwarded-For headers, preventing IP spoofing.
# When true, uvicorn trusts ALL proxy headers - ensure your proxy is properly configured to
# prevent client-supplied X-Forwarded-For values from reaching Primeagent.
#
# Example: PRIMEAGENT_RATE_LIMIT_TRUST_PROXY=true
PRIMEAGENT_RATE_LIMIT_TRUST_PROXY=

# Should store environment variables in the database
# Values: true, false
PRIMEAGENT_STORE_ENVIRONMENT_VARIABLES=

# SSRF (Server-Side Request Forgery) Protection
# When enabled, blocks requests to private IP ranges, localhost, and cloud metadata endpoints
# Values: true, false
# Default: false (for backward compatibility)
# Set to true to enable protection against SSRF attacks
PRIMEAGENT_SSRF_PROTECTION_ENABLED=

# SSRF Allowed Hosts
# Comma-separated list of hosts/IPs/CIDR ranges to allow despite SSRF protection
# Supports: exact hostnames, wildcard domains (*.example.com), exact IPs, CIDR ranges
# Example: PRIMEAGENT_SSRF_ALLOWED_HOSTS=internal-api.company.local,192.168.1.0/24,*.dev.internal
# Note: Only takes effect when PRIMEAGENT_SSRF_PROTECTION_ENABLED=true
PRIMEAGENT_SSRF_ALLOWED_HOSTS=

# Should enable the MCP composer feature in MCP projects
# Values: true, false
# Default: true
PRIMEAGENT_MCP_COMPOSER_ENABLED=

# MCP session management tuning
# These control the built-in MCPSessionManager that backs MCP tool components.
#
# PRIMEAGENT_MCP_SESSION_CLEANUP_INTERVAL – how often (seconds) the manager scans for idle
# sessions to reap. Must be >= 30; values below 30 are clamped up to prevent a
# tight CPU-spinning loop. Default: 120
# PRIMEAGENT_MCP_SESSION_CLEANUP_INTERVAL=120
#
# PRIMEAGENT_MCP_SESSION_IDLE_TIMEOUT – sessions unused for this many seconds are closed.
# Default: 400
# PRIMEAGENT_MCP_SESSION_IDLE_TIMEOUT=400
#
# PRIMEAGENT_MCP_MAX_SESSIONS_PER_SERVER – cap on concurrent live sessions per MCP server
# URL / command. Exceeding this drops the oldest session. Default: 10
# PRIMEAGENT_MCP_MAX_SESSIONS_PER_SERVER=10

# STORE_URL
# Example: PRIMEAGENT_STORE_URL=https://api.primeagent.store
# PRIMEAGENT_STORE_URL=

# DOWNLOAD_WEBHOOK_URL
#
# PRIMEAGENT_DOWNLOAD_WEBHOOK_URL=

# LIKE_WEBHOOK_URL
#
# PRIMEAGENT_LIKE_WEBHOOK_URL=

# Value must finish with slash /
#BACKEND_URL=http://localhost:7860/
BACKEND_URL=
