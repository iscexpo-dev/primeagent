{
  "schema_version": 1,
  "artifacts": {
    "python": {
      "wfx": "standalone engine; intentionally not an application tier",
      "primeagent-base": "runnable bundle-free application",
      "primeagent": "default application with the curated provider set",
      "primeagent[bundles]": "full no-Torch application provider inventory"
    },
    "images": {
      "base": "runnable bundle-free application image",
      "main-backend": "backend-only derivative of the default application",
      "main-frontend": "frontend-only static image",
      "wfx": "standalone engine image",
      "main": "default curated application image",
      "main-all": "full application image"
    }
  },
  "profiles": {
    "python-base": {
      "required_distributions": [
        "primeagent-base",
        "primeagent-sdk",
        "wfx"
      ],
      "forbidden_distributions": [
        "agent-lifecycle-toolkit",
        "chromadb",
        "langchain-chroma",
        "primeagent",
        "wfx-bundles",
        "torch",
        "torchvision"
      ],
      "forbidden_distribution_prefixes": [
        "wfx-"
      ],
      "exact_distributions": true,
      "entry_points": {
        "primeagent.extensions": [],
        "wfx.bundles": []
      },
      "bundle_names": [],
      "required_files": {
        "primeagent-base": [
          "primeagent/initial_setup/starter_projects/Basic Prompting.json"
        ]
      },
      "module_checks": [
        {
          "module": "wfx.components.cassandra",
          "expect": "error",
          "contains": "wfx[cassandra]"
        },
        {
          "module": "wfx.components.models_and_agents.policies_component",
          "expect": "error",
          "contains": "wfx[toolguard]"
        }
      ]
    },
